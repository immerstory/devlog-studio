{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./web/*"
      ],
      "devlog-studio/extension": [
        "./shared/extension.ts"
      ]
    }
  },
  "include": [
    "server",
    "shared",
    "video",
    "examples",
    "extensions",
    "web",
    "test",
    "vite.config.ts"
  ]
}